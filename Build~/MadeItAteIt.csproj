<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build without Unity. Use ../build.ps1, which finds the game and Harmony and passes
    GameManagedDir / HarmonyDll. Unity ignores this folder (name ends with "~").
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MadeItAteIt</AssemblyName>
    <RootNamespace>MadeItAteIt</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn\Timberborn_Data\Managed</GameManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Scripts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Makes the game's internal members visible, like the official Unity tools (DllPublicizer) do. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameManagedDir)\Timberborn.*.dll" Publicize="true" Private="false" />
    <Reference Include="$(GameManagedDir)\Bindito.*.dll" Private="false" />
    <Reference Include="$(GameManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(GameManagedDir)\UnityEngine.*Module.dll" Private="false" />
    <Reference Include="$(GameManagedDir)\System.Collections.Immutable.dll" Private="false" />
    <Reference Include="$(HarmonyDll)" Private="false" Condition="'$(HarmonyDll)' != ''" />
  </ItemGroup>

  <Target Name="CheckPaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedDir)\Timberborn.BaseComponentSystem.dll')"
           Text="Timberborn DLLs not found in '$(GameManagedDir)'. Pass -GameDir to build.ps1 (or /p:GameManagedDir=...)." />
    <Error Condition="'$(HarmonyDll)' == '' Or !Exists('$(HarmonyDll)')"
           Text="0Harmony.dll not found. Subscribe to the Harmony mod in the Steam Workshop or pass -HarmonyDll to build.ps1." />
  </Target>
</Project>
